# Docker Compose development defaults. Change POSTGRES_PASSWORD before sharing or deploying.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/lenny_growth
POSTGRES_DB=lenny_growth
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

LLM_PROVIDER=ollama
OLLAMA_MODEL=llama3.2:3b
OLLAMA_NUM_CTX=4096
AGENT_BACKEND=local
LLM_TIMEOUT_SECONDS=180

# Optional cloud provider settings. Leave blank for local Ollama.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
CLAUDE_CODE_OAUTH_TOKEN=
